# myarch environment template
# ---------------------------------------------------------------------------
# Copy to .secrets.env and fill in. NEVER commit the filled-in file.
#
#     cp .env.example .secrets.env
#     chmod 600 .secrets.env
#     set -a; . ./.secrets.env; set +a
#
# The real secrets file is named .secrets.env (not .env) on purpose: some tools
# pick up .env implicitly and could forward it to a build context or a CI log.
# .secrets.env is gitignored and must stay that way.
# ---------------------------------------------------------------------------

# GitHub fine-grained personal access token.
# Required scopes for the sprint workflow: Issues (write), Pull requests (write),
# Contents (write), Workflows (write), Pages (write), Codespaces (read).
# Create at: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# Repository the tooling acts on, as owner/name.
GITHUB_REPO=fufurobot/myarch

# ---------------------------------------------------------------------------
# Container secrets. These are Docker build args with safe defaults, so the
# image always builds. Override them for any real deployment.
# ---------------------------------------------------------------------------

# administrator-master: unrestricted sudo account.
ADMIN_MASTER_PASSWORD=ChangeMeAdminMaster

# VNC password for the single 1920x1080 virtual screen.
VNC_PASSWORD=ChangeMeVnc

# code-server login password.
CODE_SERVER_PASSWORD=ChangeMeCodeServer

# ---------------------------------------------------------------------------
# Optional build overrides
# ---------------------------------------------------------------------------
# Pin the code-server release instead of tracking the template default.
CODE_SERVER_VERSION=

# Extra HuggingFace token, needed only for gated/private model repositories.
HF_TOKEN=
